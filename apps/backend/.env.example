DATABASE_URL="sqlserver_database_url"

JWT_ACCESS_SECRET="<secret_key_for_access_token>"
# a refresh nem JWT token les, hanem veletlen szoveg, aminek csak a hash-e van elmentve az adatbazisban
# ez a hash alapjan lehet ellenorizni, hogy a kliens altal kuldott refresh "token" megegyezik-e azzal, amit a szerver elmentett
# JWT_REFRESH_SECRET="<secret_key_for_refresh_token>"
JWT_ACCESS_EXPIRES_IN="30m"
JWT_REFRESH_EXPIRES_IN="60d"