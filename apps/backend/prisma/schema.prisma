// Prisma schema - auto karbantarto app
// Adatbazis: SQL Server 2025 Express
//
// KODTABLAK (2026-11-04): az SQL Server Prisma-konnektor nem tamogatja az enum
// tipust, ezert az engedelyezett ertekek kis kodtablakban vannak (UserRole,
// FuelType, MaintenanceType, ...). A kodtabla kulcsa maga a szoveges kod
// (pl. "OIL_CHANGE"), igy a hivatkozo oszlop tovabbra is a kodot tarolja, de
// idegen kulcs vedi: ervenytelen erteket az adatbazis sem enged be. A name a
// megjelenitett (magyar) nev. A kodtablak sorait a migracio tolti fel.
// A backend DTO-k tovabbra is TypeScript enummal validalnak (gyors 400-as hiba).
//
// ADATBAZIS-OBJEKTUMOK A PRISMA SEMAN KIVUL (kezzel irt migracioban; a Prisma
// nem kezeli oket, ezert nincs miattuk drift):
//   - CHECK   Attachment_pontosan_egy_szulo     - pontosan egy szulo-FK kitoltve
//   - CHECK   Attachment_kep_vagy_video         - mimeType image/* vagy video/*
//   - TRIGGER trg_MaintenanceOperation_totalCost - MaintenanceLog.totalCost
//   - VIEW-k  v_AttachmentWithVehicle, v_VehicleExpense, v_VehicleMonthlyCost,
//             v_LastMaintenanceByType
//   (lasd: migrations/20261104120000_kodtablak_view_trigger)
//
// Minden relacio explicit onUpdate: NoAction-t kap, mert a PK-k UUID-k,
// sosem valtoznak - ez elkeruli a Prisma "multiple cascade paths" hibajat,
// amit az alapertelmezett onUpdate: Cascade viselkedes okozna.
//
// ---------- SZINKRONIZACIO (2026-10-30) ----------
// Minden szinkronizalt tabla ugyanazt a negy+egy mezot kapja (lasd az API es
// szinkronizacios tervet):
//   clientUpdatedAt         - a kliens utolso modositasa (orajavitva), LWW dontes
//   version                 - SQL Server rowversion, a pull kurzor. A Prisma nem
//                             ismeri a tipust, ezert Unsupported: a Prisma Client
//                             nem olvassa/irja, a pull $queryRaw-val, CAST(version
//                             AS bigint)-kent olvassa. Az SQL Server minden
//                             INSERT/UPDATE-nel magatol noveli.
//                             "timestamp" = a rowversion regi neve; az SQL Server
//                             igy adja vissza, ezert a Prisma csak ezzel a nevvel
//                             nem lat elterest (drift). A @default(dbgenerated())
//                             miatt a create() mukodik, az erteket a DB adja.
//   deletedAt               - tombstone (soft delete); NULL = el. Az isDeleted
//                             helyett a szinkronizalt tablakon.
//   lastModifiedByDeviceId  - melyik eszkoz irta utoljara (visszhang szures)
//   updatedAt               - marad, csak naplozasra
// A synced ("feltoltesre var-e") mezo csak a mobil SQLite-ban letezik: a szerveren
// minden sor szinkronizalt, ezert ott redundans lenne (2026-11-04 kikerult).
//
// Jogosultsag: a COMPANY_MEMBER a ceg osszes jarmuvet latja es barmelyikhez
// rogzithet, de csak a sajat bejegyzeseit szerkesztheti/torolheti. Ehhez minden
// bejegyzes kap egy createdByUserId mezot (a gyerektablak - MaintenanceOperation,
// ObdErrorCode - a szulojuket kovetik). A Vehicle-nel ezt az ownerUserId adja.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ---------- KODTABLAK (a korabbi enumok helyett) ----------
// Mind ugyanolyan szerkezetu: code (PK, ezt tarolja a hivatkozo oszlop) + name
// (megjelenitett nev). A hivatkozo oszlopok NVarChar(32)-esek, mert az SQL
// Server idegen kulcsnal azonos tipust es hosszt ker.

model UserRole {
  code  String @id @db.NVarChar(32)
  name  String @db.NVarChar(100)
  users User[]
}

model FuelType {
  code     String    @id @db.NVarChar(32)
  name     String    @db.NVarChar(100)
  vehicles Vehicle[]
}

model MaintenanceType {
  code        String                  @id @db.NVarChar(32)
  name        String                  @db.NVarChar(100)
  operations  MaintenanceOperation[]
  predictions MaintenancePrediction[]
}

model PredictionStatus {
  code        String                  @id @db.NVarChar(32)
  name        String                  @db.NVarChar(100)
  predictions MaintenancePrediction[]
}

model FuelUnit {
  code     String    @id @db.NVarChar(32)
  name     String    @db.NVarChar(100)
  fuelLogs FuelLog[]
}

model VehicleTaxCategory {
  code         String       @id @db.NVarChar(32)
  name         String       @db.NVarChar(100)
  vehicleTaxes VehicleTax[]
}

model Severity {
  code       String         @id @db.NVarChar(32)
  name       String         @db.NVarChar(100)
  errorCodes ObdErrorCode[]
}

model UploadStatus {
  code        String       @id @db.NVarChar(32)
  name        String       @db.NVarChar(100)
  attachments Attachment[]
}

model NotificationType {
  code          String         @id @db.NVarChar(32)
  name          String         @db.NVarChar(100)
  notifications Notification[]
}

// ---------- FELHASZNALOK / CEGEK ----------

model Company {
  id        String   @id @default(uuid())
  name      String
  taxId     String?
  // csatlakozasi kod: ezzel lep be egy maganszemely a cegbe tagkent
  joinCode  String   @unique @default(nanoid(10)) @db.NVarChar(16)
  isDeleted Boolean  @default(false) @map("is_deleted")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users    User[]
  vehicles Vehicle[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  firstName    String // regisztracional kotelezo
  lastName     String?
  role         String   @default("PRIVATE") @db.NVarChar(32) // -> UserRole
  roleRef      UserRole @relation(fields: [role], references: [code], onDelete: NoAction, onUpdate: NoAction)
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isDeleted    Boolean  @default(false) @map("is_deleted")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  vehicles      Vehicle[]
  refreshTokens RefreshToken[]
  notifications Notification[]
  syncMutations SyncMutation[]

  // a felhasznalo altal rogzitett bejegyzesek (createdByUserId)
  maintenanceLogs MaintenanceLog[]
  fuelLogs        FuelLog[]
  insurances      Insurance[]
  vehicleTaxes    VehicleTax[]
  obdScans        ObdScan[]
  aiDiagnostics   AiDiagnostic[]
  vehicleEvents   VehicleEvent[]
}

// A token nyers erteke soha nem kerul az adatbazisba: tokenHash = SHA-256 (hex).
// Rotacio: sikeres /auth/refresh utan a regi sor revoked = true, uj sor ugyanarra
// a deviceId-ra. Visszavont token ujrafelhasznalasakor a user osszes tokenje visszavonodik.
model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @db.NVarChar(64)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deviceId  String?  @db.NVarChar(64)
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
}

// ---------- JARMU ----------

model Vehicle {
  id          String   @id @default(uuid())
  ownerUserId String
  owner       User     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  make           String
  model          String
  year           Int
  vin            String?
  licensePlate   String?
  engineType     String?
  fuelType       String    @default("GASOLINE") @db.NVarChar(32) // -> FuelType
  fuelTypeRef    FuelType  @relation(fields: [fuelType], references: [code], onDelete: NoAction, onUpdate: NoAction)
  currentMileage Int       @default(0)
  purchaseDate   DateTime?

  // szinkron
  clientUpdatedAt        DateTime                 @default(now())
  version                Unsupported("timestamp") @default(dbgenerated())
  deletedAt              DateTime?
  lastModifiedByDeviceId String?                  @db.NVarChar(64)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  maintenanceLogs        MaintenanceLog[]
  maintenancePredictions MaintenancePrediction[]
  fuelLogs               FuelLog[]
  insurances             Insurance[]
  vehicleTaxes           VehicleTax[]
  obdScans               ObdScan[]
  aiDiagnostics          AiDiagnostic[]
  notifications          Notification[]
  events                 VehicleEvent[]

  @@index([ownerUserId, version])
  @@index([companyId])
}

// ---------- KARBANTARTAS ----------

// Egy szervizlatogatas (datum + km-allas). A tenyleges elvegzett
// muveleteket a MaintenanceOperation sorolja fel - egy latogataskor
// tobb fele is lehet (pl. olajcsere + fekbetet csere egyszerre).
// totalCost: denormalizalt osszeg a (nem torolt) operations.cost ertekekbol.
// Az adatbazis trigger (trg_MaintenanceOperation_totalCost) tartja naprakeszen
// minden operation INSERT/UPDATE/DELETE utan - az appnak nem kell irnia.
model MaintenanceLog {
  id              String  @id @default(uuid())
  vehicleId       String
  vehicle         Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdByUserId String
  createdBy       User    @relation(fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  serviceDate      DateTime
  mileageAtService Int
  totalCost        Decimal? @db.Decimal(10, 2) // trigger szamolja: SUM(operations.cost), ahol deletedAt IS NULL
  notes            String?

  // szinkron
  clientUpdatedAt        DateTime                 @default(now())
  version                Unsupported("timestamp") @default(dbgenerated())
  deletedAt              DateTime?
  lastModifiedByDeviceId String?                  @db.NVarChar(64)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  operations  MaintenanceOperation[]
  attachments Attachment[]

  @@index([vehicleId, version])
}

// Egy konkret muvelet (tipus + koltseg) egy MaintenanceLog-on belul.
// Szerzoje a szulo MaintenanceLog szerzoje.
model MaintenanceOperation {
  id               String         @id @default(uuid())
  maintenanceLogId String
  maintenanceLog   MaintenanceLog @relation(fields: [maintenanceLogId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  type    String          @db.NVarChar(32) // -> MaintenanceType
  typeRef MaintenanceType @relation(fields: [type], references: [code], onDelete: NoAction, onUpdate: NoAction)
  cost    Decimal?        @db.Decimal(10, 2)
  notes   String?

  // szinkron
  clientUpdatedAt        DateTime                 @default(now())
  version                Unsupported("timestamp") @default(dbgenerated())
  deletedAt              DateTime?
  lastModifiedByDeviceId String?                  @db.NVarChar(64)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  @@index([maintenanceLogId, type])
  @@index([maintenanceLogId, version])
}

// predictedDueDate / predictedDueMileage: mindket mezo nullable, mert
// egy predikcio lehet csak ido- vagy csak km-alapu (pl. muszaki vizsga
// = csak datum, olajcsere-emlekezteto = csak km). Az app-reteg
// biztositja, hogy legalabb egyik ki legyen toltve.
// A szerver generalja; a kliens szinkronban csak a status mezot modosithatja.
model MaintenancePrediction {
  id        String  @id @default(uuid())
  vehicleId String
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  maintenanceType     String           @db.NVarChar(32) // -> MaintenanceType
  maintenanceTypeRef  MaintenanceType  @relation(fields: [maintenanceType], references: [code], onDelete: NoAction, onUpdate: NoAction)
  predictedDueDate    DateTime?
  predictedDueMileage Int?
  status              String           @default("PENDING") @db.NVarChar(32) // -> PredictionStatus
  statusRef           PredictionStatus @relation(fields: [status], references: [code], onDelete: NoAction, onUpdate: NoAction)

  // szinkron
  clientUpdatedAt        DateTime                 @default(now())
  version                Unsupported("timestamp") @default(dbgenerated())
  deletedAt              DateTime?
  lastModifiedByDeviceId String?                  @db.NVarChar(64)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  @@index([vehicleId, version])
}

// ---------- UZEMANYAG ----------

model FuelLog {
  id              String  @id @default(uuid())
  vehicleId       String
  vehicle         Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdByUserId String
  createdBy       User    @relation(fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  date     DateTime
  mileage  Int
  quantity Decimal  @db.Decimal(8, 2)
  unit     String   @default("LITER") @db.NVarChar(32) // -> FuelUnit
  unitRef  FuelUnit @relation(fields: [unit], references: [code], onDelete: NoAction, onUpdate: NoAction)
  cost     Decimal  @db.Decimal(10, 2)
  fullTank Boolean  @default(true)

  // szinkron
  clientUpdatedAt        DateTime                 @default(now())
  version                Unsupported("timestamp") @default(dbgenerated())
  deletedAt              DateTime?
  lastModifiedByDeviceId String?                  @db.NVarChar(64)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  @@index([vehicleId, version])
}

// ---------- BIZTOSITAS / UTADO ----------

model Insurance {
  id              String  @id @default(uuid())
  vehicleId       String
  vehicle         Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdByUserId String
  createdBy       User    @relation(fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  provider     String
  policyNumber String
  startDate    DateTime
  endDate      DateTime
  cost         Decimal  @db.Decimal(10, 2)

  // szinkron
  clientUpdatedAt        DateTime                 @default(now())
  version                Unsupported("timestamp") @default(dbgenerated())
  deletedAt              DateTime?
  lastModifiedByDeviceId String?                  @db.NVarChar(64)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  @@index([vehicleId, version])
}

// Kocsi-kategoria szerint valtozo rovinietta kategoriak (A-H).

// Nincs unique constraint (vehicleId, year, category) kombinacion:
// szandekosan, mert egy even belul tobb, rovidebb idotartamra szolo
// rovinietta is vasarolhato ugyanahhoz a jarmuhoz.
model VehicleTax {
  id              String  @id @default(uuid())
  vehicleId       String
  vehicle         Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdByUserId String
  createdBy       User    @relation(fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  category    String             @db.NVarChar(32) // -> VehicleTaxCategory
  categoryRef VehicleTaxCategory @relation(fields: [category], references: [code], onDelete: NoAction, onUpdate: NoAction)
  year        Int
  amount      Decimal            @db.Decimal(10, 2)
  dueDate     DateTime
  paid        Boolean            @default(false)

  // szinkron
  clientUpdatedAt        DateTime                 @default(now())
  version                Unsupported("timestamp") @default(dbgenerated())
  deletedAt              DateTime?
  lastModifiedByDeviceId String?                  @db.NVarChar(64)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  @@index([vehicleId, version])
}

// ---------- OBD2 ----------

model ObdScan {
  id              String  @id @default(uuid())
  vehicleId       String
  vehicle         Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdByUserId String
  createdBy       User    @relation(fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  scanDate DateTime @default(now())
  rawData  String?  @db.NVarChar(Max)

  // szinkron
  clientUpdatedAt        DateTime                 @default(now())
  version                Unsupported("timestamp") @default(dbgenerated())
  deletedAt              DateTime?
  lastModifiedByDeviceId String?                  @db.NVarChar(64)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  errorCodes ObdErrorCode[]

  @@index([vehicleId, version])
}

// Szerzoje a szulo ObdScan szerzoje.
model ObdErrorCode {
  id        String  @id @default(uuid())
  obdScanId String
  obdScan   ObdScan @relation(fields: [obdScanId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  code        String
  description String?
  severity    String   @default("INFO") @db.NVarChar(32) // -> Severity
  severityRef Severity @relation(fields: [severity], references: [code], onDelete: NoAction, onUpdate: NoAction)

  // szinkron
  clientUpdatedAt        DateTime                 @default(now())
  version                Unsupported("timestamp") @default(dbgenerated())
  deletedAt              DateTime?
  lastModifiedByDeviceId String?                  @db.NVarChar(64)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  @@index([obdScanId, version])
}

// ---------- AI DIAGNOSZTIKA ----------
// Csak pull: letrehozasa online REST hivas.

model AiDiagnostic {
  id              String  @id @default(uuid())
  vehicleId       String
  vehicle         Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdByUserId String
  createdBy       User    @relation(fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  prompt     String?
  aiResponse String  @db.NVarChar(Max)

  // szinkron
  clientUpdatedAt        DateTime                 @default(now())
  version                Unsupported("timestamp") @default(dbgenerated())
  deletedAt              DateTime?
  lastModifiedByDeviceId String?                  @db.NVarChar(64)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  attachments Attachment[]

  @@index([vehicleId, version])
}

// ---------- CSATOLMANYOK ----------
//
// A fajl a backend lemezen van (pl. uploads/<vehicleId>/<id>.<ext>), a
// storageKey ezt a relativ utat tartalmazza. A metaadat a /sync-kel megy,
// a fajl kulon: PUT /attachments/:id/content.

model Attachment {
  id String @id @default(uuid()) // a mobilapp generálja (offline)

  // Pontosan egy szulo van kitoltve - ezt az adatbazis CHECK constraint
  // (Attachment_pontosan_egy_szulo) kenyszeriti ki. A jarmu es a szerzo a
  // szulobol szarmazik, ezert itt nincs tarolva (nincs redundancia);
  // lekerdezeshez: v_AttachmentWithVehicle view.
  // A szulo-FK-k NO ACTION-ok: harom kaszkados ut ugyanabba a tablaba SQL
  // Serveren "multiple cascade paths" hiba lenne. A torles amugy is soft delete.
  maintenanceLogId String?
  maintenanceLog   MaintenanceLog? @relation(fields: [maintenanceLogId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicleEventId   String?
  vehicleEvent     VehicleEvent?   @relation(fields: [vehicleEventId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  aiDiagnosticId   String?
  aiDiagnostic     AiDiagnostic?   @relation(fields: [aiDiagnosticId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // csak image/* vagy video/* lehet (CHECK Attachment_kep_vagy_video); a kep/video
  // tipus ebbol kovetkezik, ezert nincs kulon mediaType oszlop (v_AttachmentWithVehicle szamolja)
  mimeType   String
  sizeBytes  Int
  storageKey String? // üres, amíg nincs feltöltve
  status     String       @default("PENDING") @db.NVarChar(32) // -> UploadStatus
  statusRef  UploadStatus @relation(fields: [status], references: [code], onDelete: NoAction, onUpdate: NoAction)

  // szinkron
  clientUpdatedAt        DateTime                 @default(now())
  version                Unsupported("timestamp") @default(dbgenerated())
  deletedAt              DateTime?
  lastModifiedByDeviceId String?                  @db.NVarChar(64)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  @@index([maintenanceLogId])
  @@index([vehicleEventId])
  @@index([aiDiagnosticId])
  @@index([version])
}

// ---------- ALTALANOS ESEMENYNAPLO ----------
// Szabad "type" mezo (nem enum), hogy meg nem implementalt kovetesi
// igenyeket (pl. olajszint, regeneracio, egyeb megjegyzesek) fel
// lehessen venni migracio nelkul. Az opcionalis "amount" mezo olyan
// apro, egyedi koltsegekre valo (parkolas, autómosas), amiknek nincs
// sajat tablajuk - ezekbol nem kell kulon ExpenseLog-ot epiteni,
// az osszkoltseg-riport a MaintenanceOperation.cost + FuelLog.cost +
// Insurance.cost + VehicleTax.amount + VehicleEvent.amount
// aggregalasaval all ossze a backend oldalon.
model VehicleEvent {
  id              String  @id @default(uuid())
  vehicleId       String
  vehicle         Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdByUserId String
  createdBy       User    @relation(fields: [createdByUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  type   String // pl. "oil_level", "regeneration", "parking", stb. - app-oldalon ertelmezve
  note   String?
  amount Decimal? @db.Decimal(10, 2)

  // szinkron
  clientUpdatedAt        DateTime                 @default(now())
  version                Unsupported("timestamp") @default(dbgenerated())
  deletedAt              DateTime?
  lastModifiedByDeviceId String?                  @db.NVarChar(64)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  attachments Attachment[]

  @@index([vehicleId, type])
  @@index([vehicleId, version])
}

// ---------- ERTESITESEK ----------
// A szerver generalja; a kliens szinkronban csak a read mezot modosithatja.

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  type    String           @db.NVarChar(32) // -> NotificationType
  typeRef NotificationType @relation(fields: [type], references: [code], onDelete: NoAction, onUpdate: NoAction)
  message String
  sentAt  DateTime?
  read    Boolean          @default(false)

  // szinkron
  clientUpdatedAt        DateTime                 @default(now())
  version                Unsupported("timestamp") @default(dbgenerated())
  deletedAt              DateTime?
  lastModifiedByDeviceId String?                  @db.NVarChar(64)
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")

  @@index([userId, version])
}

// ---------- SZINKRON SEGEDTABLAK ----------

// Idempotencia: minden feldolgozott push mutation eredmenye 30 napig.
// Ha ugyanaz a mutationId ujra jon, a tarolt eredmenyt adjuk vissza (DUPLICATE).
model SyncMutation {
  mutationId String   @id // a kliens generalja (UUID)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  deviceId   String?  @db.NVarChar(64)
  entity     String   @db.NVarChar(64) // pl. "FuelLog"
  entityId   String
  result     String   @db.NVarChar(Max) // a push valasz eredmenye JSON-kent
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt]) // 30 napos takaritashoz
}

// Kulcs-ertek tabla a szerver oldali szinkron allapothoz, pl.
// "purgedVersion" = a tombstone takaritas soran fizikailag torolt legnagyobb
// version; ennel regebbi since-ra a pull 410 SYNC_RESET_REQUIRED-et ad.
model SyncState {
  key       String   @id @db.NVarChar(64)
  value     String
