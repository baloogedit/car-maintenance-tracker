{
  "name": "car-maintenance-tracker",
  "version": "1.0.0",
  "description": "Auto karbantartas-koveto alkalmazas - diplomamunka monorepo (NestJS backend + Expo/React Native mobile)",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently -n backend,mobile -c blue,green \"npm:dev:backend\" \"npm:dev:mobile\"",
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "dev:mobile": "npm run start --workspace=apps/mobile",
    "build": "npm run build --workspace=apps/backend",
    "lint": "npm run lint --workspaces --if-present",
    "lint:backend": "npm run lint --workspace=apps/backend",
    "lint:mobile": "npm run lint --workspace=apps/mobile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baloogedit/car-maintenance-tracker.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/baloogedit/car-maintenance-tracker/issues"
  },
  "homepage": "https://github.com/baloogedit/car-maintenance-tracker#readme",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.0"
  }
}
